#!/bin/bash
#
# The Dock icon. It starts the server if one is not already up, brings the
# window to the screen, and gets out of the way.
#
# This script must exit promptly. macOS treats an app bundle as running for as
# long as its executable lives, and a tap on a running app only activates it:
# the executable is never run again. An earlier version stayed alive to own the
# server, which meant closing the window left an app that was still "running"
# and could not be reopened by tapping it. So the server is detached instead
# and this exits, which makes every tap do the same thing.
#
# serve.py handles both cases on its own: it opens the window and exits if a
# server is already answering, and becomes the server if not.
#
# No Terminal window, and no weekly run. Quit from the page, which stops the
# server properly.
#
# $0 is .../2026/scripts/FEP.app/Contents/MacOS/fep-app, so the repo is four
# levels up from this file's folder.

REPO="$(cd "$(dirname "$0")/../../../.." && pwd)"
SERVER="$REPO/dashboard/serve.py"
LOG="$REPO/data/dashboard_cache/app.log"
URL_FILE="$REPO/data/dashboard_cache/url.txt"
PORT="${FEP_PORT:-8765}"

alert() {
  osascript -e "display alert \"FEP\" message \"$1\" as critical" >/dev/null 2>&1
}

if [ ! -f "$SERVER" ]; then
  alert "Cannot find the app at:
$SERVER

The icon has to stay inside the repo's scripts folder. Put it back, or drag a new copy to the Dock from there."
  exit 1
fi

# An app bundle launched from the Dock gets a minimal PATH, so the interpreter
# is named outright rather than looked up. 3.9 is the system Python this repo
# targets.
PY=/usr/bin/python3
[ -x "$PY" ] || PY="$(command -v python3)"
if [ -z "$PY" ]; then
  alert "No python3 on this machine. The app cannot start."
  exit 1
fi

cd "$REPO" || exit 1
mkdir -p "$(dirname "$LOG")"
{ echo; echo "=== $(date '+%Y-%m-%d %H:%M:%S') ==="; } >> "$LOG"

# nohup and the background, so the server outlives this script.
nohup "$PY" "$SERVER" >> "$LOG" 2>&1 &
PID=$!

# Wait only until it is answering, then leave. A start that fails does so
# quickly and the log is the only place it said why, so that gets an alert
# rather than a window that never appears.
#
# Where to look comes from the server, not from this script. The port it wanted
# is not always the port it got, and hardcoding the default here meant the
# health check polled a port nothing was on and reported a failure while the
# app was running one port over.
answering() {
  url="$(cat "$URL_FILE" 2>/dev/null)"
  [ -n "$url" ] && /usr/bin/curl -fsS -m 1 "${url%/}/api/state" >/dev/null 2>&1 && return 0
  /usr/bin/curl -fsS -m 1 "http://127.0.0.1:$PORT/api/state" >/dev/null 2>&1
}

# This script must exit promptly, but not instantly. Since macOS 27 (September
# 2026) an app whose executable exits within about half a second of launch is
# treated as a launch that failed, and the system then ends everything it
# started: the server got a SIGTERM a second after it was up, on every tap,
# and closed cleanly with nothing in any log to say why. The same script run
# from Terminal was fine, and so was the launcher once it lived two seconds.
# It is the launcher's lifetime that matters, not the server's parentage:
# a server in its own session (setsid) died the same way. So the exit waits
# until MIN_TICKS quarter seconds have passed since the server was started.
# One second was enough on a busy machine; two is the margin. The only cost
# is the icon bouncing for that long. TestLauncher in tests/test_serve.py
# pins this.
MIN_TICKS=8
TICKS=0
tick() { sleep 0.25; TICKS=$((TICKS + 1)); }
linger() { while [ "$TICKS" -lt "$MIN_TICKS" ]; do tick; done; }

# Only a start that actually failed gets an alert, and a failure is the child
# exiting without anything answering. A slow start is not a failure: alerting on
# a timeout meant a dialog saying the app could not start while the log directly
# behind it showed the app starting perfectly well.
while kill -0 "$PID" 2>/dev/null; do
  answering && { linger; exit 0; }
  tick
done

# The child exiting on its own is the normal path when a server was already up:
# serve.py opened the window and stopped. Give the socket a moment either way.
for _ in 1 2 3 4; do
  answering && { linger; exit 0; }
  tick
done

alert "The app could not start.

$(tail -n 12 "$LOG" | tr '"' "'")"
exit 1
