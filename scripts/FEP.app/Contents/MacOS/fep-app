#!/bin/bash
#
# The Dock icon. It starts the server and nothing else: no Terminal window, no
# weekly run. The page opens in the browser and the model does not run until a
# button asks it to.
#
# This process IS the app, which is what keeps the icon lit in the Dock and
# makes Quit stop the server. It deliberately does not hand off to Terminal the
# way "FEP Week" does: that one runs a week unattended and its output is the
# only place an error could appear, whereas here every action reports into the
# page itself, so a terminal would be a window showing nothing.
#
# $0 is .../2026/scripts/FEP.app/Contents/MacOS/fep-app, so the repo is four
# levels up from this file's folder.

REPO="$(cd "$(dirname "$0")/../../../.." && pwd)"
SERVER="$REPO/dashboard/serve.py"
LOG="$REPO/data/dashboard_cache/app.log"

alert() {
  osascript -e "display alert \"FEP\" message \"$1\" as critical" >/dev/null 2>&1
}

if [ ! -f "$SERVER" ]; then
  alert "Cannot find the app at:
$SERVER

The icon has to stay inside the repo's scripts folder. Put it back, or drag a new copy to the Dock from there."
  exit 1
fi

# An app bundle launched from the Dock gets a minimal PATH, so the interpreter
# is named outright rather than looked up. 3.9 is the system Python this repo
# targets.
PY=/usr/bin/python3
[ -x "$PY" ] || PY="$(command -v python3)"
if [ -z "$PY" ]; then
  alert "No python3 on this machine. The app cannot start."
  exit 1
fi

cd "$REPO" || exit 1
mkdir -p "$(dirname "$LOG")"
{ echo; echo "=== $(date '+%Y-%m-%d %H:%M:%S') ==="; } >> "$LOG"

"$PY" "$SERVER" >> "$LOG" 2>&1 &
PID=$!

# Quitting the app has to stop the server, not orphan it.
trap 'kill "$PID" 2>/dev/null' TERM INT

# A start that fails does so immediately, and the only place it said why is the
# log. Anything still alive after this is running.
sleep 3
if ! kill -0 "$PID" 2>/dev/null; then
  alert "The app could not start.

$(tail -n 12 "$LOG" | tr '"' "'")"
  exit 1
fi

wait "$PID"
